# ==============================================================================
# iNoU Cloud Relay Hub & Platform Environment Configuration
# ==============================================================================

# Server & Network Configuration
NODE_ENV=production
PORT=8765
HOST=0.0.0.0
INUO_DATA_DIR=/app/data

# Ingress & Public Domain (Used by Caddy for Automatic TLS/HTTPS)
# NOTE: This value maps to the $DOMAIN variable inside the Caddy container via docker-compose.yml.
#       Always set INUO_DOMAIN here, not DOMAIN directly.
# Example: inuo.yourdomain.com (defaults to localhost for local testing)
INUO_DOMAIN=localhost

# Local Containerized SLM Configuration (Ollama)
# When running with Docker Compose, LOCAL_LLM_URL points to the internal Ollama service
LOCAL_LLM_URL=http://ollama:11434
LOCAL_LLM_MODEL=qwen2.5:3b

# Cloud LLM Provider Credentials (Optional / Fallback)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Other Supported Cloud Providers (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Logging & Debug Level (0=SILENT, 1=INFO, 2=WARN, 3=DEBUG)
DEBUG_LEVEL=1
